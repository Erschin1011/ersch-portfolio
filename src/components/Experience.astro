---
import { experience } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section id="experience" class="border-b border-line/60"><div class="mx-auto max-w-6xl px-5 py-24 lg:px-8"><SectionHeading icon="◌" eyebrow="Professional roadmap" title="Professional Roadmap" copy="Avanzando en el camino del código: cada proyecto, bug y desafío ha construido la experiencia que tengo hoy." /><div class="mt-16 border-l border-line pl-7 sm:pl-12">{experience.map(item => <article class="relative pb-12 last:pb-0"><span class="absolute -left-[35px] top-1 h-3 w-3 rounded-full border-2 border-cyan bg-ink sm:-left-[59px]"></span><div class="flex flex-col justify-between gap-2 sm:flex-row"><h3 class="font-mono text-sm font-medium text-white">{item.role}</h3><span class="font-mono text-[10px] text-cyan">{item.date}</span></div><p class="mt-1 font-mono text-[10px] uppercase tracking-wider text-lime">{item.company}</p><p class="mt-4 max-w-2xl text-xs leading-6 text-slate-400">{item.text}</p><div class="mt-5 flex flex-wrap gap-2">{item.tags.map(tag => <span class="border border-line px-2.5 py-1 font-mono text-[10px] text-slate-500">{tag}</span>)}</div></article>)}</div></div></section>
