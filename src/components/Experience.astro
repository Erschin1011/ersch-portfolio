---
import { experience } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section id="experience" class="border-b border-line/60"><div class="mx-auto max-w-6xl px-5 py-24 lg:px-8"><SectionHeading number="2" eyebrow="Professional roadmap" title="Experience that compounds." copy="A track record of turning complex infrastructure challenges into simple, durable systems." /><div class="mt-16 border-l border-line pl-7 sm:pl-12">{experience.map((item, i) => <article class="relative pb-14 last:pb-0"><span class="absolute -left-[35px] top-1 h-3 w-3 rounded-full border-2 border-cyan bg-ink sm:-left-[59px]"></span><div class="flex flex-col justify-between gap-2 sm:flex-row"><h3 class="text-xl font-medium text-white">{item.role}</h3><span class="font-mono text-[11px] text-cyan">{item.date}</span></div><p class="mt-1 font-mono text-xs uppercase tracking-wider text-lime">{item.company}</p><p class="mt-4 max-w-2xl text-sm leading-7 text-slate-400">{item.text}</p><div class="mt-5 flex flex-wrap gap-2">{item.tags.map(tag => <span class="border border-line px-2.5 py-1 font-mono text-[10px] text-slate-500">{tag}</span>)}</div></article>)}</div></div></section>
