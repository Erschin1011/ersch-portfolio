<section id="contact" class="border-t border-line/60 bg-panel/40"><div class="mx-auto max-w-6xl px-5 py-24 lg:px-8"><h2 data-i18n="connection" class="text-center font-mono text-xl font-medium text-white"><span class="mr-3 text-cyan">▣</span>Iniciar conexión</h2><p class="mx-auto mt-4 max-w-xl text-center font-mono text-[10px] text-slate-500">erickchinchilla2004@gmail.com</p><form class="mx-auto mt-10 grid max-w-2xl gap-5 border border-line bg-panel p-5 sm:p-6" action="mailto:erickchinchilla2004@gmail.com" method="post" enctype="text/plain"><input type="hidden" name="subject" value="Contacto desde ErsCh.dev" /><div class="grid gap-5 sm:grid-cols-2"><label class="font-mono text-[9px] text-slate-500"><span data-es="NOMBRE" data-en="NAME">NOMBRE</span><input name="name" required placeholder="Escribe tu nombre" class="mt-2 w-full border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan" /></label><label class="font-mono text-[9px] text-slate-500"><span data-es="CORREO" data-en="EMAIL">CORREO</span><input name="email" type="email" required placeholder="correo@dominio.com" class="mt-2 w-full border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan" /></label></div><label class="font-mono text-[9px] text-slate-500"><span data-es="MENSAJE" data-en="MESSAGE">MENSAJE</span><textarea name="message" required rows="4" placeholder="Escribe tu mensaje aquí..." class="mt-2 w-full resize-none border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan"></textarea></label><button data-i18n="send" class="w-full bg-[#b8c0ff] px-7 py-3 font-mono text-[10px] text-[#151622] transition hover:bg-white" type="submit">&gt; Ejecutar transmisión</button></form></div></section>
