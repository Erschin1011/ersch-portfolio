---
import { projects } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section id="projects" class="border-b border-line/60"><div class="mx-auto max-w-6xl px-5 py-24 lg:px-8"><SectionHeading icon="▣" eyebrow="Active operations" title="Active Operations" /><div class="mt-14 grid gap-4 sm:grid-cols-2">{projects.slice(0, 2).map(item => <article class="group border border-line bg-panel/60 p-6 transition hover:border-cyan/70"><div class="flex justify-between"><span class="text-2xl text-cyan">{item.icon}</span><span class="font-mono text-lg text-slate-500">↗</span></div><h3 class="mt-8 font-mono text-sm text-white group-hover:text-cyan">{item.title}</h3><p class="mt-4 min-h-12 text-xs leading-5 text-slate-400">{item.text}</p><div class="mt-5 flex flex-wrap gap-2">{item.tags.map(tag => <span class="bg-[#27292d] px-2 py-1 font-mono text-[9px] text-slate-400">{tag}</span>)}</div></article>)}</div></div></section>
