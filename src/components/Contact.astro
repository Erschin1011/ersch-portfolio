<section id="contact" class="border-t border-line/60 bg-panel/40"><div class="mx-auto max-w-6xl px-5 py-24 lg:px-8"><h2 class="text-center font-mono text-xl font-medium text-white"><span class="mr-3 text-cyan">▣</span>Initiate Connection</h2><form class="mx-auto mt-10 grid max-w-2xl gap-5 border border-line bg-panel p-5 sm:p-6" action="mailto:hello@arc.systems" method="post" enctype="text/plain"><div class="grid gap-5 sm:grid-cols-2"><label class="font-mono text-[9px] text-slate-500">NAME_OR_HANDLE<input name="name" required placeholder="Enter your name" class="mt-2 w-full border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan" /></label><label class="font-mono text-[9px] text-slate-500">TRANSMISSION_ADDR<input name="email" type="email" required placeholder="email@domain.com" class="mt-2 w-full border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan" /></label></div><label class="font-mono text-[9px] text-slate-500">PAYLOAD<textarea name="message" required rows="4" placeholder="Input message payload here..." class="mt-2 w-full resize-none border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan"></textarea></label><button class="w-full bg-[#b8c0ff] px-7 py-3 font-mono text-[10px] text-[#151622] transition hover:bg-white" type="submit">&gt; Execute Transmit</button></form></div></section>
