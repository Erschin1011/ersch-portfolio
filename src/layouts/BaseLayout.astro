---
import '../styles/global.css';
const { title = 'ARC — Systems Architecture' } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Portfolio de Erick Salvador Chinchilla Chiquillo" /><title>{title}</title></head><body><slot /><script>
  const translations = {
    es: { connect: 'Conectar', profile: 'Perfil', about: 'Sobre mí', stack: 'Stack', experience: 'Experiencia', education: 'Educación', projects: 'Proyectos', contact: 'Contacto', status: 'Estado: saludable', uptime: 'Tiempo activo: 99.99%', heroDescription: 'Desarrollador de Software Junior con experiencia en desarrollo web, programación backend y gestión de bases de datos relacionales. Actualmente estudiante de cuarto año de Ingeniería en Ciencias de la Computación.', phrase: 'Transformando ideas y problemas reales en soluciones de software funcionales, claras y escalables.', stackButton: '▣ Stack', contactButton: '⌁ Contáctame', systemProfile: 'Perfil del sistema', coreStack: 'Stack principal', architecture: 'Matriz de arquitecturas', roadmap: 'Ruta profesional', academic: 'Directivas académicas', active: 'Operaciones activas', connection: 'Iniciar conexión', send: '> Ejecutar transmisión' },
    en: { connect: 'Connect', profile: 'Profile', about: 'About', stack: 'Stack', experience: 'Experience', education: 'Education', projects: 'Projects', contact: 'Contact', status: 'Status: healthy', uptime: 'Uptime: 99.99%', heroDescription: 'Junior Software Developer experienced in web development, backend programming, and relational database management. Currently a fourth-year Computer Science Engineering student.', phrase: 'Turning real-world ideas and problems into functional, clear, and scalable software solutions.', stackButton: '▣ Stack', contactButton: '⌁ Contact me', systemProfile: 'System Profile', coreStack: 'Core stack', architecture: 'Architecture Matrix', roadmap: 'Professional Roadmap', academic: 'Academic Directives', active: 'Active Operations', connection: 'Initiate Connection', send: '> Execute Transmit' }
  };
  const setLanguage = (language) => { const t = translations[language]; document.documentElement.lang = language; document.querySelectorAll('[data-i18n]').forEach((element) => { const key = element.dataset.i18n; if (t[key]) element.textContent = t[key]; }); document.querySelectorAll('[data-es][data-en]').forEach((element) => { element.textContent = language === 'en' ? element.dataset.en : element.dataset.es; }); document.querySelectorAll('[data-placeholder-es][data-placeholder-en]').forEach((element) => { element.placeholder = language === 'en' ? element.dataset.placeholderEn : element.dataset.placeholderEs; }); localStorage.setItem('portfolio-language', language); };
  const selector = document.querySelector('#language');
  const savedLanguage = localStorage.getItem('portfolio-language') || 'es';
  selector.value = savedLanguage; setLanguage(savedLanguage); selector.addEventListener('change', (event) => setLanguage(event.target.value));
</script></body></html>
