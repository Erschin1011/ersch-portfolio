<section id="contact" class="border-t border-line/60 bg-panel/40"><div class="mx-auto max-w-6xl px-5 py-24 lg:px-8"><h2 data-i18n="connection" class="text-center font-mono text-xl font-medium text-white"><span class="mr-3 text-cyan">▣</span>Iniciar conexión</h2><form class="mx-auto mt-10 grid max-w-2xl gap-5 border border-line bg-panel p-5 sm:p-6" action="mailto:erickchinchilla2004@gmail.com" method="post" enctype="text/plain"><div class="grid gap-5 sm:grid-cols-2"><label data-es="NOMBRE" data-en="NAME" class="font-mono text-[9px] text-slate-500">NOMBRE<input name="name" required placeholder="Escribe tu nombre" class="mt-2 w-full border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan" /></label><label data-es="CORREO" data-en="EMAIL" class="font-mono text-[9px] text-slate-500">CORREO<input name="email" type="email" required placeholder="correo@dominio.com" class="mt-2 w-full border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan" /></label></div><label data-es="MENSAJE" data-en="MESSAGE" class="font-mono text-[9px] text-slate-500">MENSAJE<textarea name="message" required rows="4" placeholder="Escribe tu mensaje aquí..." class="mt-2 w-full resize-none border border-line bg-ink px-3 py-3 text-xs text-white outline-none transition placeholder:text-slate-600 focus:border-cyan"></textarea></label><button data-i18n="send" class="w-full bg-[#b8c0ff] px-7 py-3 font-mono text-[10px] text-[#151622] transition hover:bg-white" type="submit">&gt; Ejecutar transmisión</button></form></div></section>
