---
import { architectureAreas, skills } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section id="about" class="border-b border-line/60"><div class="mx-auto grid max-w-6xl gap-14 px-5 py-24 lg:grid-cols-[.9fr_1.1fr] lg:px-8"><div><SectionHeading icon="♟" eyebrow="Perfil del sistema" title="Perfil del sistema" /><p data-es="Desarrollador de Software Junior con experiencia en desarrollo web, programación backend y gestión de bases de datos relacionales. Me interesa construir soluciones útiles, resolver problemas técnicos y seguir creciendo en entornos de desarrollo exigentes." data-en="Junior Software Developer experienced in web development, backend programming, and relational database management. I enjoy building useful solutions, solving technical problems, and growing in demanding development environments." class="mt-8 text-xs leading-6 text-slate-400">Desarrollador de Software Junior con experiencia en desarrollo web, programación backend y gestión de bases de datos relacionales. Me interesa construir soluciones útiles, resolver problemas técnicos y seguir creciendo en entornos de desarrollo exigentes.</p><p data-es="Mi camino comenzó en 2020 con el bachillerato en Desarrollo de Software y continúa actualmente en cuarto año de Ingeniería en Ciencias de la Computación en la Universidad Don Bosco." data-en="My journey began in 2020 with a Software Development diploma and continues today as a fourth-year Computer Science Engineering student at Universidad Don Bosco." class="mt-5 text-xs leading-6 text-slate-400">Mi camino comenzó en 2020 con el bachillerato en Desarrollo de Software y continúa actualmente en cuarto año de Ingeniería en Ciencias de la Computación en la Universidad Don Bosco.</p></div><div class="border border-line bg-panel/60 p-6"><p data-i18n="coreStack" class="font-mono text-[10px] uppercase tracking-[.2em] text-lime">Stack principal</p><ul class="mt-5 grid gap-4 text-xs text-slate-300">{skills.slice(0, 8).map(skill => <li class="flex items-center gap-3"><span class="text-lime">◉</span>{skill}</li>)}</ul></div></div></section>
<section id="stack" class="border-b border-line/60"><div class="mx-auto max-w-6xl px-5 py-24 lg:px-8"><SectionHeading icon="⌁" eyebrow="Matriz de arquitecturas" title="Matriz de arquitecturas" copy="Áreas en las que construyo, aprendo y aplico software para resolver necesidades reales." /><div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{architectureAreas.map(area => <article class="border border-line bg-panel/60 p-5 transition hover:border-cyan/70"><span class="font-mono text-2xl text-cyan">{area.icon}</span><h3 data-es={area.title} data-en={area.titleEn || area.title} class="mt-8 font-mono text-sm text-white">{area.title}</h3><p data-es={area.description} data-en={area.descriptionEn || area.description} class="mt-3 text-xs leading-5 text-slate-400">{area.description}</p><div class="mt-5 flex flex-wrap gap-2">{area.tags.map(tag => <span class="bg-[#27292d] px-2 py-1 font-mono text-[9px] text-slate-400">{tag}</span>)}</div></article>)}</div></div></section>
