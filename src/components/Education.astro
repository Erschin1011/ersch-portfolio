---
import { education } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section id="education" class="border-b border-line/60"><div class="mx-auto max-w-6xl px-5 py-24 lg:px-8"><SectionHeading icon="◆" eyebrow="Academic directives" title="Academic Directives" /><div class="mt-14 border-l border-line pl-7 sm:pl-12">{education.map(item => <article class="relative mb-6 border border-line bg-panel/60 p-6 last:mb-0"><span class="absolute -left-[34px] top-5 h-3 w-3 rounded-full border-2 border-lime bg-ink sm:-left-[59px]"></span><div class="flex flex-col-reverse justify-between gap-2 sm:flex-row"><div><h3 class="font-mono text-sm text-white">{item.title}</h3><p class="mt-1 font-mono text-[10px] text-lime">{item.school}</p></div><span class="font-mono text-[10px] text-slate-500">{item.date}</span></div><p class="mt-5 text-xs leading-6 text-slate-400">{item.text}</p></article>)}</div></div></section>
