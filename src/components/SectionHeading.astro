---
const { eyebrow, title, copy } = Astro.props;
---
<div class="max-w-2xl"><div class="mb-4 flex items-center gap-3 font-mono text-[10px] uppercase tracking-[.18em] text-cyan"><span class="text-lime">{Astro.props.icon || '▣'}</span>{eyebrow}</div><h2 class="font-mono text-xl font-medium tracking-[-.02em] text-white sm:text-2xl">{title}</h2>{copy && <p class="mt-7 text-xs leading-6 text-slate-400">{copy}</p>}</div>
